{
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "minimatch": "^10.2.3",
    "prettier": "^3.1.1",
    "turbo": "^2.6.0"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=18"
  },
  "name": "@alikuxac/datn",
  "resolutions": {
    "html-minifier": "4.0.0",
    "semver": "^7.6.3"
  }
}
