# API Configuration
# Base URL for API requests (HTTP/HTTPS)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# WebSocket Configuration
# WebSocket URL (same domain as API, using ws:// or wss://)
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# VietMap API Key
NEXT_PUBLIC_VIETMAP_API_KEY=YOUR_VIETMAP_API_KEY
