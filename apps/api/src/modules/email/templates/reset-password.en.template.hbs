<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
</head>

<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; margin: 0;">
  <div style="max-width: 600px; margin: 20px auto; border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden;">
    <div style="background-color: #ef4444; padding: 25px; text-align: center;">
      <h2 style="color: #ffffff; margin: 0;">Reset Password</h2>
    </div>
    <div style="padding: 30px;">
      <p>Hi <strong>{{name}}</strong>,</p>
      <p>Your password has been reset. Use the temporary password below:</p>
      <div style="background-color: #fff1f2; border-left: 4px solid #ef4444; padding: 15px; margin: 20px 0;">
        <p style="margin: 0; font-size: 20px; font-weight: bold; color: #991b1b;">{{password}}</p>
        <p style="margin: 5px 0 0 0; font-size: 12px; color: #b91c1c;">Valid until: {{passwordExpiredAt}}</p>
      </div>
      <p style="font-size: 13px; color: #6b7280;">Please change this password as soon as you log in.</p>
      <div style="margin-top: 25px; border-top: 1px solid #f1f5f9; padding-top: 20px;">
        <p style="font-size: 13px; color: #94a3b8;">Support: {{supportEmail}}</p>
      </div>
    </div>
  </div>
</body>

</html>