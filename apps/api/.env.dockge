# ==============================================
# DATN API - Environment Configuration (Dockge)
# ==============================================
# Copy this file to .env and fill in the values

# --- Application ---
NODE_ENV=production
APP_NAME=DATN API
APP_ENV=production
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LANGUAGE=vi

# --- HTTP Server ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
PORT=3000

# --- API Versioning ---
URL_VERSIONING_ENABLE=true
URL_VERSION=1

# --- Database (MongoDB) ---
# For Docker: use service name as host
# For external MongoDB Atlas: use connection string
DATABASE_URL=mongodb://mongo:27017/datn
DATABASE_DEBUG=false

# --- CORS ---
# Comma-separated origins or * for all
MIDDLEWARE_CORS_ORIGIN=*

# --- JWT Configuration ---
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_PREFIX=Bearer
JWT_AUDIENCE=https://your-domain.com
JWT_ISSUER=https://your-domain.com
JWT_ALGORITHM=RS256

# JWT Access Token (Short-lived)
JWT_ACCESS_TOKEN_KID=access-token-key-id
JWT_ACCESS_TOKEN_PRIVATE_KEY_PATH=/apps/keys/access-token-private.pem
JWT_ACCESS_TOKEN_PUBLIC_KEY_PATH=/apps/keys/access-token-public.pem
JWT_ACCESS_TOKEN_EXPIRATION_TIME=1h

# JWT Refresh Token (Long-lived)
JWT_REFRESH_TOKEN_KID=refresh-token-key-id
JWT_REFRESH_TOKEN_PRIVATE_KEY_PATH=/apps/keys/refresh-token-private.pem
JWT_REFRESH_TOKEN_PUBLIC_KEY_PATH=/apps/keys/refresh-token-public.pem
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d

# --- Redis (Session & Cache) ---
# For Docker: use service name as host
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=

# --- Email (SMTP) ---
# For Gmail: smtp.gmail.com:587
# For SendGrid: smtp.sendgrid.net:587
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USERNAME=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@your-domain.com
EMAIL_SUPPORT=support@your-domain.com

# --- Resend (Alternative Email Service) ---
# Get API key from https://resend.com
RESEND_API_KEY=

# --- Telegram Notifications ---
# Get bot token from @BotFather
# Get chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- S3-Compatible Storage ---
# Works with AWS S3, Backblaze B2, Cloudflare R2, MinIO, etc.

# AWS S3 Example:
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_S3_BUCKET_NAME=datn-uploads
# S3_ENDPOINT=
# AWS_S3_PUBLIC_URL=

# Backblaze B2 Example:
# AWS_REGION=us-west-004
# AWS_ACCESS_KEY_ID=your_key_id
# AWS_SECRET_ACCESS_KEY=your_application_key
# AWS_S3_BUCKET_NAME=datn-uploads
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# AWS_S3_PUBLIC_URL=https://f004.backblazeb2.com/file/datn-uploads

# Cloudflare R2 Example:
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_S3_BUCKET_NAME=datn-uploads
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_PUBLIC_URL=https://uploads.your-domain.com

# MinIO (Self-hosted) Example:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_S3_BUCKET_NAME=datn-uploads
# S3_ENDPOINT=http://minio:9000
# AWS_S3_PUBLIC_URL=http://localhost:9000/datn-uploads

# Default Configuration (Fill these):
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
S3_ENDPOINT=
AWS_S3_PUBLIC_URL=

# ==============================================
# IMPORTANT NOTES FOR DOCKGE DEPLOYMENT
# ==============================================
# 1. Generate JWT keys before deployment:
#    mkdir -p keys
#    openssl genrsa -out keys/access-token-private.pem 2048
#    openssl rsa -in keys/access-token-private.pem -pubout -out keys/access-token-public.pem
#    openssl genrsa -out keys/refresh-token-private.pem 2048
#    openssl rsa -in keys/refresh-token-private.pem -pubout -out keys/refresh-token-public.pem
#
# 2. Update compose.dockge.yaml if needed:
#    - Change ports if 3000 is already in use
#    - Add MongoDB service if not using external database
#    - Configure volumes for persistent data
#
# 3. For production:
#    - Use strong JWT_SECRET
#    - Enable HTTPS/SSL
#    - Use managed database (MongoDB Atlas)
#    - Configure proper CORS origins
#    - Set up monitoring and logging
#
# 4. S3 Storage Setup:
#    - Create bucket with public read access
#    - Configure CORS if accessing from browser
#    - Set up CDN (CloudFront/Cloudflare) for better performance
#
# 5. Start services:
#    docker-compose -f compose.dockge.yaml up -d
