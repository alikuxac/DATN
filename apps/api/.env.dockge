# Database (MongoDB Atlas/Cloud)
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# App Configuration
NODE_ENV=production
APP_NAME=DATN API
APP_ENV=production
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LANGUAGE=vi

# HTTP Configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# URL Versioning
URL_VERSIONING_ENABLE=true
URL_VERSION=1

# CORS
MIDDLEWARE_CORS_ORIGIN=*

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_PREFIX=Bearer
JWT_AUDIENCE=https://yourdomain.com
JWT_ISSUER=https://yourdomain.com
JWT_ALGORITHM=RS256

# JWT Access Token
JWT_ACCESS_TOKEN_KID=access-token-key-id
JWT_ACCESS_TOKEN_EXPIRATION_TIME=15m

# JWT Refresh Token
JWT_REFRESH_TOKEN_KID=refresh-token-key-id
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d

# Redis (Local Docker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
# Alternative: REDIS_URL=redis://redis:6379

# Email Configuration (Resend/SendGrid)
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USERNAME=resend
EMAIL_SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_SUPPORT=support@yourdomain.com

# Resend API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
