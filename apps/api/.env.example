# ==============================================
# DATN API - Environment Configuration
# ==============================================

# --- Application ---
NODE_ENV=development
APP_NAME=DATN API
APP_ENV=development
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LANGUAGE=vi

# --- HTTP Server ---
HTTP_HOST=localhost
HTTP_PORT=3000
PORT=3000

# --- API Versioning ---
URL_VERSIONING_ENABLE=true
URL_VERSION=1

# --- Database (MongoDB) ---
DATABASE_URL=mongodb://localhost:27017/datn
DATABASE_DEBUG=false

# --- CORS ---
MIDDLEWARE_CORS_ORIGIN=*

# --- JWT Configuration ---
JWT_SECRET=your-jwt-secret-key
JWT_PREFIX=Bearer
JWT_AUDIENCE=https://localhost:3000
JWT_ISSUER=https://localhost:3000
JWT_ALGORITHM=RS256

# JWT Access Token
JWT_ACCESS_TOKEN_KID=access-token-key-id
JWT_ACCESS_TOKEN_PRIVATE_KEY_PATH=/apps/keys/access-token-private.pem
JWT_ACCESS_TOKEN_PUBLIC_KEY_PATH=/apps/keys/access-token-public.pem
JWT_ACCESS_TOKEN_EXPIRATION_TIME=1h

# JWT Refresh Token
JWT_REFRESH_TOKEN_KID=refresh-token-key-id
JWT_REFRESH_TOKEN_PRIVATE_KEY_PATH=/apps/keys/refresh-token-private.pem
JWT_REFRESH_TOKEN_PUBLIC_KEY_PATH=/apps/keys/refresh-token-public.pem
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=

# --- Email (SMTP) ---
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_SUPPORT=

# --- Resend ---
RESEND_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- S3-Compatible Storage ---
# Works with AWS S3, Backblaze B2, Cloudflare R2, MinIO, etc.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Optional: Custom endpoint for S3-compatible storage
# Examples:
# - Backblaze B2: https://s3.us-west-004.backblazeb2.com
# - Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# - MinIO: http://localhost:9000
# Leave empty for AWS S3
S3_ENDPOINT=

# Optional: Custom public URL (CDN or custom domain)
# If not set, will auto-construct from endpoint or AWS S3 default
AWS_S3_PUBLIC_URL=
