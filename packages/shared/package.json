{
  "name": "@repo/shared",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "default": "./dist/enums/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "default": "./dist/interfaces/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "yarn generate:index",
    "build": "tsc",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "generate:index": "barrelsby --delete --directory ./src --location replace --include \".ts$\" --exclude \".spec.ts$\""
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "barrelsby": "^2.8.1",
    "typescript": "latest"
  }
}
